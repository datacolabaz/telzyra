# Local development. Copy to .env and adjust. Production values live in Railway.
DATABASE_URL=postgresql://telzyra:telzyra@localhost:5432/telzyra_dev
# 32 random bytes as hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_KEY=
CREDENTIALS_KEY_VERSION=1
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Production: .telzyra.com (shared by telzyra.com and api.telzyra.com)
COOKIE_DOMAIN=
LOG_LEVEL=debug
# Tests use a separate, disposable database (its schema is dropped on every run)
TEST_DATABASE_URL=postgresql://telzyra:telzyra@localhost:5432/telzyra_test
