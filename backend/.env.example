# Local development. Copy to .env and adjust. Production values live in Railway.
# `npm run db:local` starts a ready Postgres on port 54329 (no install needed)
DATABASE_URL=postgresql://telzyra:telzyra@localhost:54329/telzyra_dev
# 32 random bytes as hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_KEY=
CREDENTIALS_KEY_VERSION=1
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Production: .telzyra.com (shared by telzyra.com and api.telzyra.com)
COOKIE_DOMAIN=
LOG_LEVEL=debug
# Tests use a separate, disposable database (its schema is dropped on every run)
TEST_DATABASE_URL=postgresql://telzyra:telzyra@localhost:54329/telzyra_test

# ── Integrations ──────────────────────────────────────────────────────────────
# Public origin of this API: OAuth redirect URIs and webhook URLs are built from it.
PUBLIC_API_URL=http://localhost:4000
# Telegram triggers: auto = webhook for public https PUBLIC_API_URL, polling (getUpdates) otherwise
TELEGRAM_TRIGGER_MODE=auto
# Minutes between polls for polling triggers (Telegram polling always uses 1)
POLL_INTERVAL_MINUTES=5
RUN_WORKERS=true
# Google OAuth client (Google Cloud → Credentials → OAuth client ID → Web application)
# Authorized redirect URI: http://localhost:4000/v1/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
